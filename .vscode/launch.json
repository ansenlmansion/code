{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) 启动 bracket.c",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "gcc build bracket",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "D:\\mingw64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "运行 main.c",
            "type": "cppdbg",
